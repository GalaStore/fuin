[Desktop Entry]
Type=Application
Name=Fūin
GenericName=File Manager
GenericName[es]=Gestor de ficheros
Comment=Keyboard-first, AI-aware file manager
Comment[es]=Gestor de ficheros rápido, con teclado y funciones para IA
Exec=fuin %U
Icon=fuin
Terminal=false
StartupWMClass=fuin
Categories=Qt;KDE;System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folders;explorer;manager;fuin;archivo;ficheros;carpetas;explorador;
Actions=new-window;

[Desktop Action new-window]
Name=New window
Name[es]=Ventana nueva
Exec=fuin --new-window
